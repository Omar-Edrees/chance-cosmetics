/* The archive's orders, oldest first: {id, dt, utms, ids, referrer, source, total, raw, cancelled, acc} (the shape readOrderSource_ builds). */
function archiveOrders_() {
  if (ORDER_ARCHIVE_) return ORDER_ARCHIVE_;
  const base = Date.UTC(2026, 5, 1), n36 = x => parseInt(x, 36);
  let id = 0;
  ORDER_ARCHIVE_ = ORDER_ARCHIVE_DATA.split(';').map(e => {
    const p = e.split(':'), s = ORDER_ARCHIVE_SRC[n36(p[4])];
    id += n36(p[0]);
    const raw = p[5] ? p[5].split('.').map(x => { const q = x.split('*'); return ORDER_ARCHIVE_PROD[n36(q[0])] + ' x' + (q[1] || 1); }).join(' | ') : '';
