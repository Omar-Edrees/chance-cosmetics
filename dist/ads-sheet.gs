/* Order ID (gid://shopify/Order/…) → values in ORDER_PATCH_COLS order, or null. */
function orderPatch_(id) {
  if (!ORDER_PATCH_) {
    ORDER_PATCH_ = new Map();
    ORDER_PATCH_DATA.split(';').forEach(e => {
      const p = e.split(':'), s = ORDER_PATCH_SRC[Number(p[1])];
