/* {title: units} from the snapshot. */
function stockSnapshot_() {
  const out = {};
  STOCK_SNAPSHOT_DATA.split('\n').forEach(l => {
    const i = l.lastIndexOf('\t');
    if (i > 0) out[l.slice(0, i)] = (out[l.slice(0, i)] || 0) + Number(l.slice(i + 1));
  });
  return out;
}

