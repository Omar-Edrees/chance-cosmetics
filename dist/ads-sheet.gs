}

/* ======== 21_actual.gs ======== */
/*
 * Tab "Actual ROAS": the same sections as the Daily Account Funnel (the whole business first, then each account; this month,
 * each of the 3 months before it, those 3 together, then the last 30 days), with what really happened to the store orders
 * instead of Meta's funnel: SPEND, TOTAL ORDERS, CANCELLED (before shipping), CONFIRMED (shipped), RETURNED (shipped and came
 * back), IN SHIPPING (shipped, not delivered or back yet), DELIVERED (delivered and paid), then AOV, REVENUE (delivered
 * orders only), ROAS and CPO (spend per delivered order).
 * Orders: the same as the funnel's SHOPIFY ORDERS (the business: every store order but those from an ad account not in the
 * sheet; an account: the orders from its ads). Where each order stands comes from 19_order_status.gs (read once from Shopify);
 * a newer order counts in TOTAL ORDERS only. Spend: Meta's, from the funnel's reads. Written with the funnel, every 3 hours.
 */
const ACTUAL = {
  TITLE: 'ACTUAL ROAS', BAND: '#1f2937', MONTH_BG: '#f3f4f6', AVG3_BG: '#e8eefc',
  /* [column, field or [numerator, denominator], number format] */
  COLS: [
    ['TOTAL ORDERS', 'orders', '0'], ['CANCELLED', 'cancelled', '0'], ['CONFIRMED', 'confirmed', '0'], ['RETURNED', 'returned', '0'],
    ['IN SHIPPING', 'shipping', '0'], ['DELIVERED', 'delivered', '0'], ['AOV', ['revenue', 'delivered'], '#,##0.00'], ['REVENUE', 'revenue', '#,##0.00'],
    ['ROAS', ['revenue', 'spend'], '0.00"x"'], ['CPO', ['spend', 'delivered'], '#,##0.00']
  ]
};

/* Store orders by day since `from`, for the whole business and each account: {all: {day: counts}, acc: {id: {day: counts}}}. */
function actualShop_(from) {
  const out = { all: {}, acc: {} }, z = () => ({ orders: 0, cancelled: 0, confirmed: 0, returned: 0, shipping: 0, delivered: 0, revenue: 0 });
  const add = (map, d, o, st) => {
    const x = map[d] = map[d] || z();
    x.orders++;
    if (!st) return;
    if (st.code === 'C') x.cancelled++;
    if ('RDS'.indexOf(st.code) >= 0) x.confirmed++;
    if (st.code === 'R') x.returned++;
    if (st.code === 'S') x.shipping++;
    if (st.code === 'D') { x.delivered++; x.revenue += st.revenue === null ? num_(o[7]) : st.revenue; }
  };
  funnelShop_(from, (o, d, acc) => {
    const st = orderStatus_(o[0]);
    add(out.all, d, o, st);
    if (acc) add(out.acc[acc] = out.acc[acc] || {}, d, o, st);
  });
  return out;
}
function actualSum_(days, from, to, spend) {
  const t = { spend: spend || 0, orders: 0, cancelled: 0, confirmed: 0, returned: 0, shipping: 0, delivered: 0, revenue: 0 };
  Object.keys(days || {}).forEach(d => { if (d >= from && d <= to) Object.keys(days[d]).forEach(k => { t[k] += days[d][k]; }); });
  return t;
}

/* Draws the tab (inside the lock) from the funnel's Meta reads (fetchFunnel_). Nothing is written when nothing changed. */
function writeActual_(data) {
  const A = ACTUAL, sh = ensureTab_(X.ACTUAL), g = todayGrid_(), W = 2 + A.COLS.length, today = todayKey_();
  g.width = W;
  const past = data.months.slice(1), shop = actualShop_(data.months[data.months.length - 1] + '-01');
  const range3 = funnelMonthName_(past[past.length - 1]).slice(0, 3) + '–' + funnelMonthName_(past[0]);
  const monthEnd = ym => { const p = ym.split('-').map(Number); return new Date(Date.UTC(p[0], p[1], 0)).toISOString().slice(0, 10); };
  g.set(1, 1, A.TITLE + ' — الأرقام الفعلية من شوبيفاي | آخر تحديث ' + nowText_(), { bg: A.BAND, fc: '#ffffff', b: 'bold', al: 'center' });
  g.fill(1, 2, W - 1, { bg: A.BAND });
  g.merge(1, 1, 1, W);
  g.set(2, 1, 'TOTAL ORDERS = أوردرات شوبيفاي (البيزنس كله: كلها ماعدا الأكاونت اللي مش معانا؛ الأكاونت: اللي جت من إعلاناته). ' +
    'CANCELLED = اتلغى قبل الشحن. CONFIRMED = اتشحن (RETURNED + IN SHIPPING + DELIVERED). RETURNED = اتشحن ورجع أو اتلغى بعد الشحن. ' +
    'IN SHIPPING = في الشحن ولسه ماتسلمش ولا رجع. DELIVERED = اتسلم واتحصّل. REVENUE = مبيعات المتسلم بس، و AOV عليه. ROAS = REVENUE ÷ SPEND. CPO = SPEND ÷ DELIVERED. ' +
    'حالة الأوردرات من شوبيفاي لحد ' + ORDER_STATUS_AT + '، والأوردر الأحدث محسوب في TOTAL ORDERS بس.', { al: 'left' });
  g.merge(2, 1, 1, W);
  ['DATE', 'SPEND'].concat(A.COLS.map(c => c[0])).forEach((h, i) => g.set(3, 1 + i, h, { bg: '#fff200', b: 'bold', al: 'center' }));
  let r = 4;
  const line = (label, t, style) => {
    g.set(r, 1, label, Object.assign({ al: 'center' }, style));
    g.set(r, 2, Math.round(t.spend * 100) / 100, Object.assign({ nf: '#,##0.00', al: 'center' }, style));
    A.COLS.forEach((c, i) => {
      const v = Array.isArray(c[1]) ? ratioOrBlank_(t[c[1][0]], t[c[1][1]], 4) : (c[1] === 'revenue' ? Math.round(t.revenue * 100) / 100 : t[c[1]]);
      g.set(r, 3 + i, v, Object.assign({ nf: c[2], al: 'center' }, style));
    });
    r++;
  };
  const section = (name, months, days, error, shopDays) => {
    g.set(r, 1, name + (error ? '   ⚠️ ماقدرتش أقرا الحساب: ' + error : ''), { bg: A.BAND, fc: '#ffffff', b: 'bold' });
    g.fill(r, 2, W - 1, { bg: A.BAND });
    g.merge(r, 1, 1, W);
    r++;
    if (error) return;
    data.months.forEach((ym, i) => line(funnelMonthName_(ym) + (i ? '' : ' (لحد النهارده)'),
      actualSum_(shopDays, ym + '-01', i ? monthEnd(ym) : today, (months[ym] || {}).spend), { bg: A.MONTH_BG, b: 'bold' }));
    line('آخر 3 شهور (' + range3 + ')', actualSum_(shopDays, past[past.length - 1] + '-01', monthEnd(past[0]),
      past.reduce((s, ym) => s + num_((months[ym] || {}).spend), 0)), { bg: A.AVG3_BG, b: 'bold' });
    days.forEach(d => {
      const p = d.date.split('-').map(Number);
      line(Utilities.formatDate(new Date(Date.UTC(p[0], p[1] - 1, p[2], 12)), 'UTC', 'EEE dd-MMM'), actualSum_(shopDays, d.date, d.date, d.raw.spend), {});
    });
  };
  const ok = data.accounts.filter(a => !a.error), allMonths = {}, allDays = {};
  data.months.forEach(ym => { allMonths[ym] = { spend: ok.reduce((s, a) => s + num_((a.months[ym] || {}).spend), 0) }; });
  ok.forEach(a => a.days.forEach(d => { allDays[d.date] = { spend: num_((allDays[d.date] || {}).spend) + num_(d.raw.spend) }; }));
  if (ok.length > 1) section('كل الحسابات (البيزنس كله)', allMonths,
    Object.keys(allDays).sort().reverse().map(d => ({ date: d, raw: allDays[d] })), '', shop.all);
  data.accounts.forEach(a => section(a.name, a.months, a.days, a.error, shop.acc[a.id] || {}));
  if (!data.accounts.length) g.set(r, 1, 'مفيش حساب Meta صرف في الفترة دي', { fc: '#6b7280' });
  if (!writeGrid_(sh, g)) return;
  sh.setFrozenRows(3);
  sh.setColumnWidth(1, 190);
  for (let c = 2; c <= W; c++) sh.setColumnWidth(c, 95);
  sh.getRange(2, 1, 1, W).setWrap(true);
  sh.setRowHeight(2, 60);
  sh.getRange(3, 1, 1, W).setWrap(true);
}

/* ======== 22_top.gs ======== */
/*
 * Tab "توب 100": five lists of up to 100 products for the period in B2:B3 (this month by default), each with its live stock:
 * best sellers (units sold), highest ROAS (spend on the product's ads vs its orders' sales, like the product table in Today,
 * for products with at least TOP.MIN_SPEND spend), most stock, selling without ads (no spend on its own ads and no share of
 * catalog ads), and dead stock (stock with the fewest sales). Units: the line items of store orders that weren't cancelled
 * or returned (19_order_status.gs). The lists sit side by side. Refreshed with the slow views and when B2 / B3 change.
 */
const TOP = { N: 100, MIN_SPEND: 500 };

function writeTopTab_() {
  const sh = ensureTab_(X.TOP), today = todayKey_(), week = shiftKey_(today, -6);
  sh.getRange('A1:A3').setValues([['توب 100 — اختار الفترة'], ['من'], ['إلى']]);
  sh.getRange('A1').setFontWeight('bold').setFontSize(13);
  sh.getRange('B2:B3').setNumberFormat('@').setBackground('#fff2cc');
  const p = periodFromCells_(sh), special = [APP.CATALOG, APP.MULTI, APP.UNMAPPED, APP.META_NO_AD, APP.UNKNOWN_PRODUCT, ''];
  const stock0 = stockByName_(), stockOf = stock0.by, active = activeMap_();

  // Units sold, orders and last sale per product (every line item, not only the first one).
  const units = {}, ordersWith = {}, units7 = {}, last = {}, nameOf = {};
  rawRows_(APP.T.ORDERS, ORDERS_HEADERS.length).forEach(o => {
    const d = asKey_(o[2]), s = orderStatus_(o[0]);
    if (!d || (s && (s.code === 'C' || s.code === 'R')) || o[15] === true || String(o[15]).toUpperCase() === 'TRUE') return;
    const seen = new Set();
    lineItems_(o[6]).forEach(li => {
      const n = nameOf[li.title] = nameOf[li.title] || productNameOf_(li.title);
      if (!last[n] || d > last[n]) last[n] = d;
      if (d >= week && d <= today) units7[n] = (units7[n] || 0) + li.qty;
      if (d < p.from || d > p.to) return;
      units[n] = (units[n] || 0) + li.qty;
      if (!seen.has(n)) { ordersWith[n] = (ordersWith[n] || 0) + 1; seen.add(n); }
    });
  });
  // Spend (every platform) and ad orders (Meta, TikTok and DIRECT, like the product table in Today) per product.
  const ad = {};
  dailyRows_().forEach(r => {
    if (r[0] < p.from || r[0] > p.to) return;
    const t = ad[r[2]] = ad[r[2]] || { spend: 0, orders: 0, revenue: 0 };
    if (r[1] === 'META' || r[1] === 'TIKTOK') t.spend += num_(r[3]);
    if (r[1] === 'META' || r[1] === 'TIKTOK' || r[1] === APP.DIRECT) { t.orders += num_(r[8]); t.revenue += num_(r[10]); }
  });
  // The product's share of catalog ads (الكتالوج tab): not in its ROAS, but a product shown there isn't "without ads".
  const cat = {};
  if (ss_().getSheetByName(APP.T.CATALOG)) recentRows_(APP.T.CATALOG, CATALOG_HEADERS.length, 1, asKey_, p.from).forEach(r => {
    const d = asKey_(r[0]), n = catalogProduct_(r[4]);
    if (d <= p.to) cat[n] = (cat[n] || 0) + num_(r[5]);
  });

  const names = Array.from(new Set(Object.keys(units).concat(Object.keys(stockOf), Object.keys(ad)))).filter(n => special.indexOf(n) < 0);
  const stock = n => (stockOf[n] === undefined ? '' : stockOf[n]);
  const cover = n => {
    const s = stockOf[n], perDay = (units7[n] || 0) / 7;
    return s === undefined ? '' : s <= 0 ? 'نفد' : perDay > 0 ? Math.floor(s / perDay) : '—';
  };
  const spend = n => (ad[n] ? ad[n].spend : 0);
  const top = list => (list.length ? list.slice(0, TOP.N).map((r, i) => [i + 1].concat(r)) : [['', 'مفيش منتجات هنا في الفترة دي']]);

  const best = top(names.filter(n => units[n] > 0).sort((a, b) => (units[b] - units[a]) || (ordersWith[b] - ordersWith[a]))
    .map(n => [n, units[n], ordersWith[n], stock(n), cover(n), active[n] || '']));
  const roas = top(names.filter(n => spend(n) >= TOP.MIN_SPEND).map(n => ({ n: n, t: ad[n], r: ad[n].revenue / ad[n].spend }))
    .sort((a, b) => (b.r - a.r) || (b.t.spend - a.t.spend))
    .map(x => [x.n, round2_(x.t.spend), x.t.orders, round2_(x.t.revenue), round2_(x.r), x.t.orders ? round2_(x.t.spend / x.t.orders) : '', stock(x.n)]));
  const most = top(names.filter(n => stockOf[n] > 0).sort((a, b) => stockOf[b] - stockOf[a])
    .map(n => [n, stockOf[n], units[n] || 0, cover(n), last[n] || 'مااتباعش']));
  const noAds = top(names.filter(n => units[n] > 0 && spend(n) <= 0 && !(cat[n] > 0)).sort((a, b) => (units[b] - units[a]) || (ordersWith[b] - ordersWith[a]))
    .map(n => [n, units[n], ordersWith[n], stock(n), last[n]]));
  const dead = top(names.filter(n => stockOf[n] > 0).sort((a, b) => ((units[a] || 0) - (units[b] || 0)) || (stockOf[b] - stockOf[a]))
    .map(n => [n, stockOf[n], units[n] || 0, last[n] || 'مااتباعش', cover(n)]));

  const period = ' (' + p.from + ' لـ ' + p.to + ')';
  sh.getRange('C2:D2').setValues([['الستوك', stock0.status]]);
  const at = writeSideBlocks_(sh, 5, [
    { title: '1) الأكثر مبيعًا' + period + ' — قطع اتباعت في أوردرات مااتلغتش ولا رجعت', rows: best,
      headers: ['#', 'المنتج', 'قطع اتباعت', 'أوردرات فيها المنتج', 'الستوك', 'الستوك يكفي كام يوم', 'إعلانات Meta شغالة'] },
    { title: '2) الأعلى Shopify ROAS' + period + ' — مبيعات أوردرات إعلانات المنتج (و DIRECT) ÷ الصرف عليه، للي اتصرف عليه ' + TOP.MIN_SPEND + ' أو أكتر', rows: roas,
      headers: ['#', 'المنتج', 'الصرف', 'الأوردرات', 'المبيعات', 'Shopify ROAS', 'CPP', 'الستوك'] },
    { title: '3) أعلى ستوك — الستوك دلوقتي، والمبيعات في الفترة', rows: most,
      headers: ['#', 'المنتج', 'الستوك', 'قطع اتباعت', 'الستوك يكفي كام يوم', 'آخر مرة اتباع'] },
    { title: '4) بيتباع من غير إعلانات' + period + ' — مفيش صرف على إعلانات المنتج ولا ظهر في إعلانات الكتالوج في الفترة', rows: noAds,
      headers: ['#', 'المنتج', 'قطع اتباعت', 'أوردرات فيها المنتج', 'الستوك', 'آخر مرة اتباع'] },
    { title: '5) الرواكد' + period + ' — عنده ستوك، والأقل مبيعًا الأول (وبعدين الأكتر ستوك)', rows: dead,
      headers: ['#', 'المنتج', 'الستوك', 'قطع اتباعت', 'آخر مرة اتباع', 'الستوك يكفي كام يوم'] }
  ]);
  // Per block: # narrow, product wide, the rest even; the empty column between blocks thin.
  for (let c = 1; c <= at.width; c++) sh.setColumnWidth(c, 95);
  at.cols.forEach((c, k) => { sh.setColumnWidth(c, 35); sh.setColumnWidth(c + 1, 260); if (k) sh.setColumnWidth(c - 1, 16); });
  sh.setFrozenRows(6);
}

