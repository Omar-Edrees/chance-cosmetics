let ORDER_GOV_ = null;
/* Order ID (gid://shopify/Order/…) → governorate, or '' (no address, or newer than ORDER_GOV_AT). */
function orderGov_(id) {
  if (!ORDER_GOV_) {
    ORDER_GOV_ = new Map();
    let n = 0;
    ORDER_GOV_DATA.split(';').forEach(e => {
      n += parseInt(e.slice(0, -1), 36);
      ORDER_GOV_.set('gid://shopify/Order/' + n, ORDER_GOVS['ABCDEFGHIJKLMNOPQRSTUVWXYZ_'.indexOf(e.slice(-1))]);
    });
  }
  return ORDER_GOV_.get(String(id)) || '';
}

/* ======== 25_governorates.gs ======== */
/*
 * Tab "المحافظات" (like House of Beauty's Governorates, plus what happened to the orders): store orders by governorate
 * today / this month / the period in B2:B3 (the last 90 days by default), then for the period: cancellation (cancelled
 * before shipping ÷ the orders whose status is known), delivery and return (delivered or returned ÷ the shipments that
 * finished; orders still in shipping aren't counted yet). Orders: every store order but those from an ad account not in
 * the sheet, like Actual ROAS. Governorate: 24_order_gov.gs, else the orders sheet's City / Province column. Status:
 * 19_order_status.gs. The tables sit side by side. Written with the views every 15 minutes, and when B2 / B3 change.
 */
const GOV = {
  UNKNOWN: 'مش معروفة',
  /* Names the orders sheet may carry (Shopify's English names, codes, Arabic) → ORDER_GOVS. */
  ALIASES: {
    'cairo': 'القاهرة', 'c': 'القاهرة', 'helwan': 'القاهرة', 'giza': 'الجيزة', 'gz': 'الجيزة', '6th of october': 'الجيزة',
    'alexandria': 'الإسكندرية', 'alx': 'الإسكندرية', 'dakahlia': 'الدقهلية', 'qalyubia': 'القليوبية', 'al sharqia': 'الشرقية',
    'sharqia': 'الشرقية', 'gharbia': 'الغربية', 'beheira': 'البحيرة', 'monufia': 'المنوفية', 'red sea': 'البحر الأحمر',
    'damietta': 'دمياط', 'minya': 'المنيا', 'port said': 'بورسعيد', 'asyut': 'أسيوط', 'sohag': 'سوهاج', 'ismailia': 'الإسماعيلية',
    'kafr el-sheikh': 'كفر الشيخ', 'suez': 'السويس', 'beni suef': 'بني سويف', 'matrouh': 'مطروح', 'faiyum': 'الفيوم',
    'aswan': 'أسوان', 'south sinai': 'جنوب سيناء', 'qena': 'قنا', 'luxor': 'الأقصر', 'new valley': 'الوادي الجديد',
    'north sinai': 'شمال سيناء'
  }
};

/* The governorate an order went to, or ''. */
function govOf_(o) {
  const g = orderGov_(o[0]);
  if (g) return g;
  const raw = String(o[8] || '').trim(), k = raw.toLowerCase().replace(/\s+/g, ' ');
  if (!raw) return '';
  if (GOV.ALIASES[k]) return GOV.ALIASES[k];
  const plain = s => s.replace(/[أإآ]/g, 'ا').replace(/^محافظة\s*/, '');
  return ORDER_GOVS.find(x => plain(x) === plain(raw)) || '';
}

function writeGovTab_() {
  const sh = ensureTab_(X.GOV), today = todayKey_(), month0 = today.slice(0, 8) + '01';
  sh.getRange('A1:A3').setValues([['المحافظات — اختار الفترة'], ['من'], ['إلى']]);
  sh.getRange('A1').setFontWeight('bold').setFontSize(13);
  sh.getRange('B2:B3').setNumberFormat('@').setBackground('#fff2cc');
  if (!asKey_(sh.getRange('B2').getValue())) sh.getRange('B2').setValue(shiftKey_(today, -89));
  const p = periodFromCells_(sh), by = {}, z = () => ({ day: 0, month: 0, orders: 0, C: 0, R: 0, D: 0, S: 0, P: 0, none: 0 });
  const tot = z();
  funnelShop_(p.from < month0 ? p.from : month0, (o, d) => {
    const g = govOf_(o) || GOV.UNKNOWN, x = by[g] = by[g] || z();
    [x, tot].forEach(t => {
      if (d === today) t.day++;
      if (d >= month0 && d <= today) t.month++;
      if (d < p.from || d > p.to) return;
      t.orders++;
      const s = orderStatus_(o[0]);
      if (s) t[s.code]++; else t.none++;
    });
  });
  const names = Object.keys(by).sort((a, b) => (a === GOV.UNKNOWN) - (b === GOV.UNKNOWN) || (by[b].orders - by[a].orders) || (by[b].month - by[a].month));
  const share = (n, t) => (t > 0 ? n / t : '');
  const rate = (n, t) => (t > 0 ? n / t : '');
  const known = t => t.C + t.R + t.D + t.S, done = t => t.D + t.R;
  const table = f => names.map(n => f(n, by[n])).concat([f('الإجمالي', tot)]);
  const range = ' (' + p.from + ' لـ ' + p.to + ')';
  const blocks = [
    { title: '1) الأوردرات حسب المحافظة — الفترة' + range, headers: ['المحافظة', 'النهارده', '% من النهارده', 'الشهر ده', '% من الشهر', 'الفترة', '% من الفترة'],
      rows: table((n, t) => [n, t.day, share(t.day, tot.day), t.month, share(t.month, tot.month), t.orders, share(t.orders, tot.orders)]), pct: [3, 5, 7] },
    { title: '2) نسبة الإلغاء' + range + ' — اتلغى قبل الشحن ÷ الأوردرات اللي حالتها معروفة (من غير اللي لسه ماتشحنش)',
      headers: ['المحافظة', 'الأوردرات', 'اتلغى قبل الشحن', 'نسبة الإلغاء', 'لسه ماتشحنش', 'حالتها لسه مش عندي'],
      rows: table((n, t) => [n, t.orders, t.C, rate(t.C, known(t)), t.P, t.none]), pct: [4] },
    { title: '3) نسبة التوصيل' + range + ' — اتسلم ÷ (اتسلم + رجع)، واللي لسه في الشحن مش محسوب',
      headers: ['المحافظة', 'اتشحن', 'اتسلم', 'نسبة التسليم', 'لسه في الشحن', 'اتسلم من كل الأوردرات'],
      rows: table((n, t) => [n, t.D + t.R + t.S, t.D, rate(t.D, done(t)), t.S, rate(t.D, known(t))]), pct: [4, 6] },
    { title: '4) نسبة المرتجع' + range + ' — رجع ÷ (اتسلم + رجع)، واللي لسه في الشحن مش محسوب',
      headers: ['المحافظة', 'اتشحن', 'رجع', 'نسبة المرتجع', 'لسه في الشحن', 'رجع من كل الأوردرات'],
      rows: table((n, t) => [n, t.D + t.R + t.S, t.R, rate(t.R, done(t)), t.S, rate(t.R, known(t))]), pct: [4, 6] }
  ];
  sh.getRange('C2:D3').setValues([['حالة الأوردرات وعنوانها من شوبيفاي لحد', ORDER_STATUS_AT],
    ['', 'الأوردر الأحدث بيظهر في جدول 1 بس، ومحافظته "' + GOV.UNKNOWN + '" لحد ما تتقري']]);
  const at = writeSideBlocks_(sh, 5, blocks), first = 7, n = names.length + 1;
  sh.getRange(first, 1, n, at.width).setNumberFormat('#,##0'); // a cell that held a % before never keeps it
  blocks.forEach((b, k) => {
    b.pct.forEach(c => sh.getRange(first, at.cols[k] + c - 1, n, 1).setNumberFormat('0.0%'));
    sh.getRange(first + n - 1, at.cols[k], 1, b.headers.length).setFontWeight('bold').setBackground('#e5e7eb');
  });
  for (let c = 1; c <= at.width; c++) sh.setColumnWidth(c, 110);
  at.cols.forEach((c, k) => { sh.setColumnWidth(c, 150); if (k) sh.setColumnWidth(c - 1, 16); });
  sh.setFrozenRows(6);
}

/* ======== 26_balances.gs ======== */
/*
 * What's left in each Meta ad account, read from Meta every 15 minutes (with the light extras) and shown in Today under
 * the closing table: the available balance of a prepaid account (as Billing shows it), how many days it lasts at the last
 * 3 days' spend, what a card account spent and wasn't charged yet, what's left under the account spending limit, and
 * the account status. Read-only: the same token, no writes to Meta.
 */
const BAL = {
  KEY: 'ACC_BALANCE', FUNDING: 'funding_source_details',
  FIELDS: 'account_status,currency,balance,amount_spent,spend_cap,is_prepay_account',
  STATUS: { 1: 'شغال', 2: 'متوقف', 3: '⚠️ عليه فلوس ماتدفعتش', 7: 'تحت المراجعة', 8: 'مستني تسوية', 9: 'فترة سماح',
    100: 'هيتقفل', 101: 'مقفول', 201: 'شغال', 202: 'مقفول' }
};

/* Reads every Meta account in Accounts and keeps the result in the document properties for Today. */
function refreshBalances_() {
  const acc = {};
  accounts_('META').forEach(a => {
    let p, note = '';
    try { p = metaGet_('act_' + a.id, { fields: BAL.FIELDS + ',' + BAL.FUNDING }); } catch (e) {
      // Some tokens may read the account but not how it's paid: then the balance of a prepaid account is unknown.
      try { p = metaGet_('act_' + a.id, { fields: BAL.FIELDS }); note = 'Meta مابتدّيش رصيد الشحن للتوكن ده'; } catch (e2) { acc[a.id] = { error: errText_(e2) }; return; }
    }
    acc[a.id] = balanceOf_(p, note);
  });
  PropertiesService.getDocumentProperties().setProperty(BAL.KEY, JSON.stringify({ at: nowText_(), acc: acc }));
  return acc;
}

/* One account's reply → {status, prepay, avail, owed, capLeft, note}. Money in Meta's minor unit (1/100). */
function balanceOf_(p, note) {
  const fs = p.funding_source_details || {}, shown = String(fs.display_string || ''), prepay = p.is_prepay_account === true || String(p.is_prepay_account) === 'true';
  // A prepaid account's funding source reads like "Available balance (EGP 1,234.56)" (or in Arabic); a card's has no balance in it.
  const stored = Number(fs.type) === 20 || /balance|رصيد/i.test(shown), m = stored ? digits_(shown).replace(/[,٬]/g, '').replace(/٫/g, '.').match(/-?\d+(?:\.\d+)?/) : null;
  const cap = Number(p.spend_cap || 0);
  return { status: Number(p.account_status) || 0, prepay: prepay, avail: m ? Number(m[0]) : null,
    owed: prepay ? null : Number(p.balance || 0) / 100, capLeft: cap > 0 ? Math.max(cap - Number(p.amount_spent || 0), 0) / 100 : null,
    note: note || (prepay && !m ? 'Meta مابيّنتش الرصيد' : '') };
}

/* Today, left side under the closing table, from row r. Returns the row after it. */
function todayBalances_(g, r, today) {
  const S = TODAY, accs = accounts_('META');
  if (!accs.length) return r;
  let saved = {};
  try { saved = JSON.parse(PropertiesService.getDocumentProperties().getProperty(BAL.KEY) || '{}'); } catch (e) { saved = {}; }
  g.set(r, 1, 'رصيد الأكاونتات من Meta' + (saved.at ? ' — آخر قراية ' + saved.at : ''), { bg: S.DARK, fc: '#ffffff', b: 'bold', al: 'center' });
  g.fill(r, 2, 5, { bg: S.DARK });
  g.merge(r, 1, 1, 6);
  r++;
  ['AD ACCOUNT NAME', 'الرصيد المتاح', 'يكفي كام يوم', 'اتصرف ولسه ماتخصمش من الكارت', 'فاضل على حد الصرف', 'الحالة']
    .forEach((h, i) => g.set(r, 1 + i, h, { bg: S.YELLOW, b: 'bold', al: 'center' }));
  r++;
  // Average spend of the last 3 full days per account (Account Raw).
  const from = shiftKey_(today, -3), to = shiftKey_(today, -1), spend = {};
  rawRows_(APP.T.ACC_RAW, ACC_HEADERS.length).forEach(a => {
    const d = asKey_(a[0]);
    if (a[1] === 'META' && d >= from && d <= to) spend[String(a[2])] = (spend[String(a[2])] || 0) + num_(a[4]);
  });
  accs.forEach(a => {
    const x = (saved.acc || {})[a.id], perDay = (spend[a.id] || 0) / 3, money = { nf: S.MONEY, al: 'right' };
    g.set(r, 1, a.name || a.id, { b: 'bold' });
    if (!x) g.set(r, 2, 'لسه ماتقراش — هيظهر مع التحديث الجاي', { fc: '#6b7280' });
    else if (x.error) g.set(r, 2, '✗ ' + x.error, { fc: '#b91c1c' });
    else {
      const left = x.avail !== null ? x.avail : x.capLeft, days = left === null || !(perDay > 0) ? '' : left / perDay;
      g.set(r, 2, x.avail !== null ? x.avail : x.prepay ? (x.note || '') : 'كارت (بيتخصم لوحده)', x.avail !== null ? money : { fc: '#6b7280' });
      g.set(r, 3, days === '' ? '' : Math.floor(days * 10) / 10, { nf: '0.0', al: 'right', bg: days === '' ? null : days < 1 ? S.RED : days < 3 ? '#fff2cc' : S.GREEN });
      g.set(r, 4, x.owed === null ? '' : x.owed, money);
      g.set(r, 5, x.capLeft === null ? 'مفيش حد' : x.capLeft, x.capLeft === null ? { fc: '#6b7280' } : money);
      g.set(r, 6, BAL.STATUS[x.status] || String(x.status || ''), x.status === 1 || x.status === 201 ? {} : { bg: S.RED, b: 'bold' });
    }
    r++;
  });
  return r;
}

/* ======== 90_hooks.gs ======== */
/*
 * Extension for Shopify stores:
 *  - Stock: read live stock from the Shopify Flow stock tab (+ optional one-time product export).
 *  - Products tab auto-filled from the stock sheet (title + handle + price) so ad landing pages map exactly.
 *  - "المنتجات": products from best seller to least, live stock, running ✅, key numbers.
 *  - "تعادل الحسابات": each ad account day by day vs break-even, to see where the month drops.
 *  - "توب 100": best sellers, highest ROAS, most stock, selling without ads and dead stock (22_top.gs).
 *  - "المحافظات": orders, cancellation, delivery and return by governorate (25_governorates.gs).
 *  - Today: what's left in each Meta ad account, read every 15 minutes (26_balances.gs).
 *  - Running ✅ = the product has at least one ACTIVE Meta ad now (or TikTok spend today/yesterday).
 * Read-only on Meta and Shopify.
 */

function chanceSetup_() {
  ensureTab_(X.PRODUCTS); ensureTab_(X.ACC_BE); ensureTab_(X.CATALOG); ensureTab_(X.FUNNEL); ensureTab_(X.ACTUAL); ensureTab_(X.TOP); ensureTab_(X.GOV);
  const tk = ['date', 'account_id', 'campaign', 'adgroup', 'ad_id', 'ad', 'spend', 'impressions', 'clicks', 'purchases', 'landing']
    .map(k => cfgStr_('tiktok.col.' + k)).filter(Boolean);
  ensureTab_(cfgStr_('tiktok.tab') || 'TikTok Data', tk);
}
function chanceLive_() {
  STOCK_ = null;
  const props = PropertiesService.getDocumentProperties(), today = todayKey_();
  if (props.getProperty('STOCK_DAY') !== today) { // stock → Products: once a day
    props.setProperty('STOCK_DAY', today);
    try { if (autoAddProducts_()) withLock_(() => refreshAdMap_([], {}, false)); } catch (e) { setStatus_('STOCK', '✗ ' + errText_(e)); }
  }
  try { refreshActive_(); } catch (e) { setStatus_('ACTIVE', '✗ ' + errText_(e)); }
  try { refreshBalances_(); } catch (e) { setStatus_('BALANCE', '✗ ' + errText_(e)); }
}
function chanceViews_(slow) { writeCatalogTab_(); writeGovTab_(); if (slow) { writeProductsTab_(); writeAccountsBE_(); writeTopTab_(); } }
function chanceEdit_(name, a1) {
  if (name === X.PRODUCTS && (a1 === 'B2' || a1 === 'B3')) writeProductsTab_();
  if (name === X.ACC_BE && a1 === 'B2') writeAccountsBE_();
  if (name === X.TOP && (a1 === 'B2' || a1 === 'B3')) writeTopTab_();
  if (name === X.GOV && (a1 === 'B2' || a1 === 'B3')) writeGovTab_();
}
function refreshProductsNow() {
  try {
    resetCaches_(); chanceLive_();
    withLock_(() => { rebuildViews_({ full: true, slow: true }); });
    alert_('اتحدثت المنتجات والستوك ✅\nالستوك: ' + getStatus_('STOCK') + '\nالإعلانات الشغالة: ' + getStatus_('ACTIVE'));
    ss_().setActiveSheet(tab_(X.PRODUCTS));
  } catch (e) { alert_('التحديث ماكملش:\n' + errText_(e)); }
}

/* Extension hooks the engine calls. Arrow wrappers so files load in any order.
 * views: after the core views are rebuilt (inside the lock). edit: onEdit(e). setup: inside setupAll's lock.
 * live: after ads sync, before views (outside the lock, for reads). today: the same for ⚡ (Today's own reads).
 * menu: [label, functionName]. */
const EXT = {
  views: [slow => chanceViews_(slow)],
  edit: [(name, a1) => chanceEdit_(name, a1)],
  setup: [() => chanceSetup_()],
  live: [() => refreshAccountNames_(), () => discoverAccounts_(), () => chanceLive_(), () => refreshTodayFunnel_(), () => refreshFunnel_(false)],
  today: [() => refreshTodayFunnel_(), () => refreshBalances_()],
  menu: [['📦 تحديث المنتجات والستوك وتوب 100', 'refreshProductsNow'], ['📈 تحديث Daily Account Funnel و Actual ROAS', 'refreshFunnelNow']]
};
