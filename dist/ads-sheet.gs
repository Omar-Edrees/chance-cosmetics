let ORDER_STATUS_ = null;
/* Order ID (gid://shopify/Order/…) → {code, revenue (or null: the order total)}, or null (newer than ORDER_STATUS_AT). */
function orderStatus_(id) {
  if (!ORDER_STATUS_) {
    ORDER_STATUS_ = new Map();
    let n = 0;
    ORDER_STATUS_DATA.split(';').forEach(e => {
      const m = e.match(/^([0-9a-z]+?)([CRDSP])(.*)$/);
      n += parseInt(m[1], 36);
      ORDER_STATUS_.set('gid://shopify/Order/' + n, { code: m[2], revenue: m[3] === '' ? null : Number(m[3]) });
    });
  }
  return ORDER_STATUS_.get(String(id)) || null;
}

